# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estadisticas_pagos
DB_USER=estadisticas_user
DB_PASSWORD=tu_password_seguro

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_para_estadisticas
JWT_EXPIRES_IN=24h

# Servidor
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/pdf

# Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tuCorreo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicación

# Sistema
NOMBRE_SISTEMA=Vanguard Estadísticas Pagos
VERSION_SISTEMA=1.0.0
